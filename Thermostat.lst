0383             87   ;---------------------------------;
0383             88   ; Routine to initialize the ISR   ;
0383             89   ; for timer 2                     ;
0383             90   ;---------------------------------;
0383             91   Timer2_Init:
0383 75C800      92            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
0386 75CDBF      93            mov TH2, #high(TIMER2_RELOAD)
0389 75CC28      94            mov TL2, #low(TIMER2_RELOAD)
038C             95            ; Set the reload value
038C 43C980      96            orl T2MOD, #0x80 ; Enable timer 2 autoreload
038F 75CBBF      97            mov RCMP2H, #high(TIMER2_RELOAD)
0392 75CA28      98            mov RCMP2L, #low(TIMER2_RELOAD)
0395             99            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
0395 E4         100            clr a
0396 F542       101            mov Count1ms+0, a
0398 F543       102            mov Count1ms+1, a
039A            103            ; Enable the timer and interrupts
039A 439B80     104            orl EIE, #0x80 ; Enable timer 2 interrupt ET2=1
039D D2CA       105       setb TR2  ; Enable timer 2
039F 22         106            ret
03A0            107   
03A0            108   ;---------------------------------;
03A0            109   ; ISR for timer 2                 ;
03A0            110   ;---------------------------------;
03A0            111   Timer2_ISR:
03A0 C2CF       112            clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in the ISR.  It is bit addressable.
03A2 B284       113            cpl P0.4 ; To check the interrupt rate with oscilloscope. It must be precisely a 1 ms pulse.
03A4            114            
03A4            115            ; The two registers used in the ISR must be saved in the stack
03A4 C0E0       116            push acc
03A6 C0D0       117            push psw
03A8            118            
03A8            119            ; Increment the 16-bit one mili second counter
03A8 0542       120            inc Count1ms+0    ; Increment the low 8-bits first
03AA E542       121            mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
03AC 7002       122            jnz Inc_Done
03AE 0543       123            inc Count1ms+1
03B0            124   
03B0            125   Inc_Done:
03B0            126            ; Check if half second has passed
03B0 E542       127            mov a, Count1ms+0
03B2 B42C0C     128            cjne a, #low(300), Timer2_ISR_done ; Warning: this instruction changes the carry flag!
03B5 E543       129            mov a, Count1ms+1
03B7 B40107     130            cjne a, #high(300), Timer2_ISR_done
03BA            131            
03BA            132            ; 1 second have passed.  Set a flag so the main program knows
03BA D201       133            setb second_flag ; Let the main program know half second had passed
03BC            134            ; Reset to zero the milli-seconds counter, it is a 16-bit variable
03BC            135            
03BC E4         136            clr a
03BD F542       137            mov Count1ms+0, a
03BF F543       138            mov Count1ms+1, a
03C1            139            
03C1            140   Timer2_ISR_done:
03C1 D0D0       141            pop psw
03C3 D0E0       142            pop acc
03C5 32         143            reti
03C6            144   
03C6            145   Init_All:
03C6            146            ; Configure all the pins for biderectional I/O
03C6 75AC00     147            mov     P3M1, #0x00
03C9 75AD00     148            mov     P3M2, #0x00
03CC 75B300     149            mov     P1M1, #0x00
03CF 75B400     150            mov     P1M2, #0x00
03D2 75B100     151            mov     P0M1, #0x00
03D5 75B200     152            mov     P0M2, #0x00
03D8            153            
03D8 438E10     154            orl     CKCON, #0x10 ; CLK is the input for timer 1
03DB 438780     155            orl     PCON, #0x80 ; Bit SMOD=1, double baud rate
03DE 759852     156            mov     SCON, #0x52
03E1 53C4DF     157            anl     T3CON, #0b11011111
03E4 53890F     158            anl     TMOD, #0x0F ; Clear the configuration bits for timer 1
03E7 438920     159            orl     TMOD, #0x20 ; Timer 1 Mode 2
03EA 758DF7     160            mov     TH1, #TIMER1_RELOAD ; TH1=TIMER1_RELOAD;
03ED D28E       161            setb TR1
03EF            162            
03EF            163            ; Using timer 0 for delay functions.  Initialize here:
03EF C28C       164            clr     TR0 ; Stop timer 0
03F1 438E08     165            orl     CKCON,#0x08 ; CLK is the input for timer 0
03F4 5389F0     166            anl     TMOD,#0xF0 ; Clear the configuration bits for timer 0
03F7 438901     167            orl     TMOD,#0x01 ; Timer 0 in Mode 1: 16-bit timer
03FA            168            
03FA            169            ; Initialize the pin used by the ADC (P1.1) as input.
03FA 43B302     170            orl     P1M1, #0b00000010
03FD 53B4FD     171            anl     P1M2, #0b11111101
0400            172            
0400            173            ; Initialize and start the ADC:
0400 53E8F0     174            anl ADCCON0, #0xF0
0403 43E807     175            orl ADCCON0, #0x07 ; Select channel 7
0406            176            ; AINDIDS select if some pins are analog inputs or digital I/O:
0406 75F600     177            mov AINDIDS, #0x00 ; Disable all analog inputs
0409 43F680     178            orl AINDIDS, #0b10000000 ; P1.1 is analog input
040C 43E101     179            orl ADCCON1, #0x01 ; Enable ADC
