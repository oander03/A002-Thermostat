046A            207   wait_1ms:
046A C28C       208            clr     TR0 ; Stop timer 0
046C C28D       209            clr     TF0 ; Clear overflow flag
046E 758CBF     210            mov     TH0, #high(TIMER0_RELOAD_1MS)
0471 758A28     211            mov     TL0,#low(TIMER0_RELOAD_1MS)
0474 D28C       212            setb TR0
0476 308DFD     213            jnb     TF0, $ ; Wait for overflow
0479 22         214            ret
